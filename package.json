{
  "name": "yumi",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@yumi/api' --filter '@yumi/web' dev",
    "db:up": "docker compose up -d postgres",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '@yumi/web' i18n:compile && bun test",
    "build": "bun run --filter '@yumi/web' build",
    "check": "bun run lint && bun run typecheck && bun run test",
    "prepare": "lefthook install",
    "db:migrate": "bun --env-file=.env packages/db/src/migrate.ts",
    "db:seed": "bun --env-file=.env packages/db/src/seed.ts",
    "db:generate": "bun run --filter '@yumi/db' db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
